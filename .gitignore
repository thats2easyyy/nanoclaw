# Dependencies
node_modules/
.npm-cache/
# Build output
dist/

# Local data & auth
store/
data/
logs/

# Groups - only track base structure and specific CLAUDE.md files
# NOTE: groups/main/CLAUDE.md is untracked here (contains per-install
# persona / personal preferences). Global CLAUDE.md stays tracked.
groups/*
!groups/main/
!groups/global/
groups/main/*
groups/global/*
!groups/global/CLAUDE.md

# Secrets
*.keys.json
.env

# Temp files
.tmp-*

# OS
.DS_Store

# IDE
.idea/
.vscode/

# Skills system (local per-installation state)
.nanoclaw/

agents-sdk-docs
